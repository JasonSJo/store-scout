# docker compose 가 읽는 값. cp .env.example .env 로 복사해 채우십시오.
# .env 는 .gitignore 에 있습니다 — 커밋하지 마십시오.

# 올리는 커밋. /healthz 가 이 값을 내보내 어떤 알고리즘 판이 판정했는지 밝힙니다.
#   STORE_SCOUT_REV=$(git rev-parse HEAD)
STORE_SCOUT_REV=

# HTTPS 를 앞에서 끝낼 때 1 로 둡니다. 그래야 세션 쿠키에 Secure 가 붙습니다.
# ⚠ Cloudflare Tunnel 을 쓰면 **반드시 1** 이어야 합니다. 비워 두면 로그인
#   쿠키가 Secure 없이 나가고, 평문 경로가 하나라도 있으면 그대로 샙니다.
STORE_SCOUT_HTTPS=1

# Cloudflare Tunnel 토큰 (--profile tunnel 로 띄울 때만)
# Zero Trust → Networks → Tunnels → 터널 생성 → Docker 설치 명령에 들어 있는 값
CLOUDFLARE_TUNNEL_TOKEN=

# 소상공인365 Open API 인증키
# 신청결과 URL에 들어 있던 기존 키는 노출된 것으로 보고 재발급한 새 키만 넣으십시오.
# 서버 전용 값입니다. web/.env 또는 VITE_ 변수에는 절대 넣지 마십시오.
SBIZ_STARTUP_PUBLIC_CERT_KEY=
SBIZ_HP_REPORT_CERT_KEY=
SBIZ_WEATHER_CERT_KEY=
SBIZ_SALES_INDEX_CERT_KEY=
SBIZ_STORE_STATUS_CERT_KEY=
SBIZ_STORE_CAREER_CERT_KEY=
SBIZ_DETAIL_CERT_KEY=
SBIZ_DELIVERY_CERT_KEY=
SBIZ_TOUR_CERT_KEY=
SBIZ_SIMPLE_CERT_KEY=
SBIZ_SNS_CERT_KEY=
